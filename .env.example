# Docker behind your own HTTPS reverse proxy. Origins have no trailing slash.
# Use two distinct hostnames; changing only ports does not isolate cookies.
PLATFORM_ORIGIN=https://play.example.com
GAMES_ORIGIN=https://games.example.com
GITHUB_TOKEN=
DATA_VOLUME_NAME=playroom-data
BACKUP_DIR=./backups

# Optional OTA deployment with compose.ota.yaml (Linux host only).
# DEPLOY_DIR=/opt/playroom-platform
# COMPOSE_PROJECT_NAME=playroom
# UPDATE_REPOSITORY=https://github.com/TommyLamm/playroom-platform.git
# UPDATE_BRANCH=main
# UPDATER_TOKEN=<random 64-character hex value>
# APP_COMMIT=<git rev-parse HEAD>

# Direct Node development only, not production Docker Compose.
# Replace the origins above for local HTTP; do not set NODE_ENV=production.
# PLATFORM_ORIGIN=http://localhost:3000
# GAMES_ORIGIN=http://127.0.0.1:3001
# PORT=3000
# GAMES_PORT=3001
# DATA_DIR=./data
