{
  "name": "mini-game-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"cross-env NODE_ENV=development tsx watch server/main.ts\" \"vite --host localhost\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "admin:init": "node dist/server/cli.js admin:init",
    "demo:seed": "node dist/server/cli.js demo:seed",
    "backup": "node dist/server/cli.js backup",
    "restore": "node dist/server/cli.js restore",
    "game:pack": "tsx scripts/pack-game.ts",
    "game:validate": "tsx scripts/validate-game.ts",
    "game:schema": "tsx scripts/export-game-schema.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "geoip-country": "^5.0.202610030217",
    "lucide-react": "^0.468.0",
    "mime-types": "^3.0.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "overrides": {
    "geoip-country": {
      "ip-address": "10.7.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
