{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9]+(?:[.-][a-zA-Z0-9]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "tags": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "devices": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "desktop",
          "mobile"
        ]
      }
    },
    "leaderboard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "order": {
          "default": "desc",
          "type": "string",
          "enum": [
            "desc",
            "asc"
          ]
        },
        "unit": {
          "default": "分",
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "minScore": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxScore": {
          "default": 9007199254740991,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "cloudSave": {
      "type": "object",
      "properties": {
        "readableFormats": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "writeFormat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "readableFormats",
        "writeFormat"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "entry",
    "cover",
    "tags",
    "instructions",
    "devices"
  ],
  "additionalProperties": false,
  "title": "PLAYROOM Game Manifest v1 and v2",
  "description": "Manifest input structure; defaults are applied by the platform validator. Run game:validate for score-range, cloudSave schema-version/read-write relationships, archive, portable path and referenced-file checks."
}
